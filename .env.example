# Server
HOST=0.0.0.0
PORT=3001
PLUGIN_TIMEOUT=30000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fresh_donate
DB_USER=postgres
DB_PASSWORD=postgres

# Admin Panel Credentials
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-in-production

# JWT
# Leave empty to let the backend generate one and keep it in the database
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000

# Payment
# URL where the buyer is redirected after payment (your shop frontend)
PAYMENT_RETURN_URL=http://localhost:3002
# Public base URL of this backend for webhook callbacks
WEBHOOK_BASE_URL=http://localhost:3001
# Skip Wata signature check (sandbox / debugging only)
# WATA_SKIP_SIGNATURE_CHECK=true
# Skip Tebex signature check (sandbox / debugging only)
# TEBEX_SKIP_SIGNATURE_CHECK=true
# Skip CryptoBot signature check (sandbox / debugging only)
# CRYPTOBOT_SKIP_SIGNATURE_CHECK=true
# Skip Robokassa signature check (sandbox / debugging only)
# ROBOKASSA_SKIP_SIGNATURE_CHECK=true

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Docker Compose
SERVER_PORT=3001
